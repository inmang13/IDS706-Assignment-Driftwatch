# --- data source ---
SOURCE=snapshot                 # snapshot | live   (live hits USGS; only set it on purpose)
USGS_API_KEY=                   # optional; raises the rate limit

# --- LLM runtime for the agents ---
LLM=fallback                    # gemini | openrouter | fallback   (tests and the Pi use fallback)
GOOGLE_CLOUD_PROJECT=           # your GCP project id
GOOGLE_APPLICATION_CREDENTIALS= # path to a service-account JSON, e.g. C:/keys/my-project-sa.json
GEMINI_MODEL=gemini-3.8-flash   # Vertex model id (code default if blank)
OPENROUTER_API_KEY=
SKEPTIC_MODEL=openai/gpt-5.4-mini  # OpenRouter slug, vendor/model (code default if blank)

# --- HW: Part 1 warehouse (docker-compose.yml sets these inside the containers) ---
DRIFTWATCH_SOURCE=snapshot      # snapshot | warehouse  (warehouse = read the Airflow-loaded Postgres)
WAREHOUSE_URL=postgresql://driftwatch:driftwatch@localhost:5433/driftwatch

# --- service ---
API_BASE_URL=http://localhost:8000
TRACE_DIR=traces