{
  "name": "DriftWatch HW",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "pip install -e '.[dev,agents,api,warehouse]'",
  "forwardPorts": [8000, 8080, 5433],
  "containerEnv": {
    "LLM": "fallback",
    "WAREHOUSE_URL": "postgresql://driftwatch:driftwatch@host.docker.internal:5433/driftwatch"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
